# Copy this file to .env.local and replace the placeholder with a key from Google AI Studio.
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Optional overrides
GEMINI_MODEL=gemini-2.5-flash
VIVA_QUESTION_MODEL=gemini-3.5-flash-lite
CLINICAL_CASE_MODEL=gemini-3.5-flash-lite
CLINICAL_CASE_EVALUATION_MODEL=gemini-3.5-flash
VIVA_AI_PROVIDER=gemini

# Firebase Admin credential JSON path (server/local environment only; never commit the JSON).
# Installing the SDK does not select Firebase. Set DATABASE_PROVIDER=firebase only after migration verification.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=
# Optional public web-app configuration overrides. Normally discovered from the registered Firebase web app.
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_NAMESPACE=medicomm
DATABASE_PROVIDER=
# For Firebase, choose local (persistent private VPS files) or firebase (requires a bucket / Blaze plan).
UPLOAD_STORAGE=
FIREBASE_STORAGE_BUCKET=
# Required in production when UPLOAD_STORAGE=local. Must be a persistent directory outside the public web root.
RUNTIME_DATA_DIR=

# Supabase server credentials (never use a VITE_ prefix for the secret).
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Exact origins, comma-separated, without trailing slash. Render defaults include its service URL and both medullaprep.com domains.
APP_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,http://localhost:4174,http://127.0.0.1:4174
# Defaults to medicomm-uploads on Render; apply scripts/supabase-schema.sql to create the private bucket.
SUPABASE_UPLOAD_BUCKET=
# Enable only behind a proxy that replaces X-Forwarded-For and blocks direct access.
TRUST_PROXY=false

# Optional verified sender for Firebase verification links and payment thank-you emails.
# Without these, verification uses Firebase's default sender. Password recovery always uses Firebase.
RESEND_API_KEY=
EMAIL_FROM=

# Web Push: generate once using npm run setup:push; keep the private key on the server.
# Copy the generated values to your production host and keep them stable across deployments.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://medullaprep.com
# Daily reminder time, Asia/Kolkata (0–23). An always-running backend is required.
PUSH_REMINDER_HOUR_IST=18

# Server only. Checkout receives the public key ID from /api/create-order.
# Never expose RAZORPAY_KEY_SECRET using a VITE_ prefix.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
