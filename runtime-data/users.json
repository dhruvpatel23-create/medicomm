  "questions": [
    {
      "id": "a84da7f7f5e798cb96196beb",
      "year": 2023,
      "topic": "Pelvis and Perineum",
      "answer": "Deep transverse perineal muscle",
      "examId": "neet-pg-pyqs",
      "images": [],
      "prompt": "A surgeon is performing a procedure involving the superficial perineal pouch in a male patient. Which of the following structures would NOT typically be encountered within this anatomical space?",
      "source": "ai",
      "options": [
        "Bulbospongiosus muscle",
        "Spongy urethra",
        "Deep transverse perineal muscle",
        "Ischiocavernosus muscle"
      ],
      "createdAt": "2026-05-27T19:52:47.629Z",
      "subjectId": "anatomy",
      "difficulty": "exam",
      "answerIndex": 2,
      "explanation": "The superficial perineal pouch in males contains the root of the penis (comprising the bulb of the penis covered by the bulbospongiosus muscle and the crura of the penis covered by the ischiocavernosus muscles), the spongy urethra (within the bulb of the penis), and the superficial transverse perineal muscles. The deep transverse perineal muscle, along with the external urethral sphincter and the bulbourethral glands, is located in the deep perineal pouch, superior to the perineal membrane.",
      "subjectTitle": "Anatomy"
    },
    {
      "id": "6581487684a9be32ebef7bb4",
      "year": 2023,
      "topic": "Pelvis and Perineum",
      "answer": "Piriformis",
      "examId": "neet-pg-pyqs",
      "images": [],
      "prompt": "Which of the following muscles is NOT a component of the levator ani group?",
      "source": "ai",
      "options": [
        "Puborectalis",
        "Pubococcygeus",
        "Iliococcygeus",
        "Piriformis"
      ],
      "createdAt": "2026-05-27T19:50:55.908Z",
      "subjectId": "anatomy",
      "difficulty": "exam",
      "answerIndex": 3,
      "explanation": "The levator ani muscle group is a broad, thin muscle forming the floor of the pelvis. It consists of three main parts: the puborectalis, pubococcygeus, and iliococcygeus. These muscles collectively support the pelvic viscera and play a crucial role in continence. The piriformis muscle, while located in the pelvic region, is a muscle of the gluteal region and the posterior wall of the pelvis, and is not considered part of the levator ani.",
      "subjectTitle": "Anatomy"
    },
    {
      "id": "18debca354b8a69bd2aff5f5",
      "year": 2023,
      "topic": "Pelvis and Perineum",
      "answer": "Urethra",
      "examId": "neet-pg-pyqs",
      "images": [],
      "prompt": "Which of the following structures is located within the deep perineal pouch?",
      "source": "ai",
      "options": [
